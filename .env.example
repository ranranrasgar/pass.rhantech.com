# Salin ke .env lalu sesuaikan. Jangan commit .env.
DATABASE_URL="postgresql://postgres:@localhost:5432/venuepass?schema=public"

# Auth.js — buat dengan: npx auth secret  (atau: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="ganti-dengan-secret-acak-yang-kuat"
AUTH_TRUST_HOST=true

APP_TIMEZONE="Asia/Jakarta"

# Kunci AES-256-GCM untuk token_encrypted (cetak ulang QR, Fase 3). 32 byte base64.
QR_ENC_KEY="ganti-dengan-32-byte-base64"

# Super Admin awal (dipakai oleh: npx prisma db seed)
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@venuepass.local"
SEED_ADMIN_PASSWORD="ganti-password-awal"

# Database terpisah untuk tes integrasi (npm run test:int) — boleh dikosongkan/di-reset.
TEST_DATABASE_URL="postgresql://postgres:@localhost:5432/venuepass_test?schema=public"
