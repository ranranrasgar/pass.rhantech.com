// Skema lengkap VenuePass: PRD §9.3 + tambahan docs/RENCANA_FASE.md §1.4.
// Semua waktu disimpan dalam UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  GATE_OFFICER
  VIEWER
}

enum EventStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum GuestStatus {
  ACTIVE
  CANCELLED
}

enum ScanResult {
  SUCCESS
  UNKNOWN_QR
  ALREADY_CHECKED_IN
  INACTIVE
  WRONG_EVENT
  ERROR
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}

// LABEL = satu label per halaman (printer label/gelang); A4/LETTER = lembar berisi grid label.
enum PaperSize {
  A4
  LETTER
  LABEL
}

// DARK = gaya gelang tamu (hitam + emas).
enum PrintTheme {
  LIGHT
  DARK
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  gateAssignments GateAssignment[]
  checkIns        CheckIn[]
  scanLogs        ScanLog[]
  importBatches   ImportBatch[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Event {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(191)
  venueName String      @map("venue_name") @db.VarChar(191)
  eventDate DateTime    @map("event_date")
  status    EventStatus @default(DRAFT)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  gates         Gate[]
  guests        Guest[]
  checkIns      CheckIn[]
  scanLogs      ScanLog[]
  importBatches ImportBatch[]

  @@index([status])
  @@map("events")
}

model Gate {
  id       Int     @id @default(autoincrement())
  eventId  Int     @map("event_id")
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  event       Event            @relation(fields: [eventId], references: [id])
  assignments GateAssignment[]
  checkIns    CheckIn[]
  scanLogs    ScanLog[]

  @@unique([eventId, name])
  @@map("gates")
}

// Keputusan §1.3 #1: penugasan petugas ke satu/beberapa gate.
model GateAssignment {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  gateId Int @map("gate_id")

  user User @relation(fields: [userId], references: [id])
  gate Gate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@unique([userId, gateId])
  @@index([gateId])
  @@map("gate_assignments")
}

model Guest {
  id            Int         @id @default(autoincrement())
  eventId       Int         @map("event_id")
  externalCode  String?     @map("external_code") @db.VarChar(100)
  name          String      @db.VarChar(191)
  groupName     String      @map("group_name") @db.VarChar(100)
  status        GuestStatus @default(ACTIVE)
  notes         String?     @db.Text
  importBatchId Int?        @map("import_batch_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  event          Event          @relation(fields: [eventId], references: [id])
  importBatch    ImportBatch?   @relation(fields: [importBatchId], references: [id])
  qrCredentials  QrCredential[]
  checkIns       CheckIn[]

  @@unique([eventId, externalCode])
  @@index([eventId, groupName])
  @@index([eventId, name])
  @@map("guests")
}

model QrCredential {
  id             Int       @id @default(autoincrement())
  guestId        Int       @map("guest_id")
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  tokenLast4     String?   @map("token_last4") @db.VarChar(4)
  // Keputusan §1.3 #2: AES-256-GCM (QR_ENC_KEY) hanya untuk cetak ulang.
  tokenEncrypted String?   @map("token_encrypted") @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  revokedAt      DateTime? @map("revoked_at")

  guest Guest @relation(fields: [guestId], references: [id])

  @@index([guestId, isActive])
  @@map("qr_credentials")
}

model CheckIn {
  id          Int      @id @default(autoincrement())
  guestId     Int      @map("guest_id")
  eventId     Int      @map("event_id")
  gateId      Int      @map("gate_id")
  userId      Int      @map("user_id")
  checkedInAt DateTime @default(now()) @map("checked_in_at")

  guest Guest @relation(fields: [guestId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
  gate  Gate  @relation(fields: [gateId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  // Kebijakan satu kali check-in per tamu per event (PRD §9.4).
  @@unique([guestId, eventId])
  @@index([eventId, checkedInAt])
  @@index([gateId])
  @@map("check_ins")
}

model ScanLog {
  id               Int        @id @default(autoincrement())
  eventId          Int        @map("event_id")
  gateId           Int?       @map("gate_id")
  userId           Int?       @map("user_id")
  // Sidik jari token (bukan token mentah).
  tokenFingerprint String?    @map("token_fingerprint") @db.VarChar(64)
  result           ScanResult
  message          String     @db.VarChar(255)
  scannedAt        DateTime   @default(now()) @map("scanned_at")

  event Event @relation(fields: [eventId], references: [id])
  gate  Gate? @relation(fields: [gateId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@index([eventId, scannedAt])
  @@index([eventId, result])
  @@map("scan_logs")
}

model ImportBatch {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  fileName    String   @map("file_name") @db.VarChar(255)
  totalRows   Int      @map("total_rows")
  successRows Int      @map("success_rows")
  failedRows  Int      @map("failed_rows")
  createdBy   Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  event  Event   @relation(fields: [eventId], references: [id])
  user   User    @relation(fields: [createdBy], references: [id])
  guests Guest[]

  @@map("import_batches")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(50)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  reason     String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PrintPreset {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  widthMm     Decimal     @map("width_mm") @db.Decimal(6, 2)
  heightMm    Decimal     @map("height_mm") @db.Decimal(6, 2)
  marginMm    Decimal     @map("margin_mm") @db.Decimal(6, 2)
  gapXMm      Decimal     @map("gap_x_mm") @db.Decimal(6, 2)
  gapYMm      Decimal     @map("gap_y_mm") @db.Decimal(6, 2)
  // null = otomatis
  columns     Int?
  orientation Orientation @default(PORTRAIT)
  paper       PaperSize   @default(A4)
  theme       PrintTheme  @default(LIGHT)
  fields      Json
  qrSizeMm    Decimal     @map("qr_size_mm") @db.Decimal(6, 2)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("print_presets")
}

model AppSetting {
  key   String @id @db.VarChar(100)
  value Json

  @@map("app_settings")
}
